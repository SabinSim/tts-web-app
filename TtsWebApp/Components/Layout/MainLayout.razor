@inherits LayoutComponentBase
@inject NavigationManager Nav

@* Modified: removed sidebar + NavMenu, replaced with a minimal top header / added tab navigation *@
<div class="app-shell">

    <header class="app-header">
        <div class="app-header-inner">

            <div class="app-logo">
                <span class="app-logo-icon">◎</span>
                <span class="app-logo-text">TTS Web App</span>
            </div>

            @* Modified: TTS / Translate / Chat tab navigation *@
            <nav class="app-tabs">
                <a class="app-tab @(IsActive("/") ? "active" : "")" href="/">
                    TTS
                </a>
                <a class="app-tab @(IsActive("/translate") ? "active" : "")" href="/translate">
                    Translate
                </a>
                @* Added: AI chat tab *@
                <a class="app-tab @(IsActive("/chat") ? "active" : "")" href="/chat">
                    Chat
                </a>
            </nav>

            <a class="app-github-link"
               href="https://github.com/SabinSim/tts-web-app"
               target="_blank"
               rel="noopener noreferrer">
                GitHub
            </a>

        </div>
    </header>

    <main class="app-content">
        @Body
    </main>

</div>

@code {
    // Added: determine the active class by comparing the current path with the tab path
    private bool IsActive(string path)
    {
        var current = Nav.ToBaseRelativePath(Nav.Uri);
        if (path == "/")
            return current == "" || current == "/";
        return ("/" + current).StartsWith(path, StringComparison.OrdinalIgnoreCase);
    }
}