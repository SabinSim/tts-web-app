@page "/"

<PageTitle>LinguaAI — AI Language Companion</PageTitle>

<div class="home-wrap">

    @* ── Hero ─────────────────────────────────────────────────── *@
    <section class="home-hero">
        <div class="home-brand">
            <div class="home-brand-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                     stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 8l6 6" /><path d="M4 14l6-6 2-2" />
                    <path d="M2 5h12" /><path d="M7 2h1" />
                    <path d="M22 22l-5-10-5 10" /><path d="M14 18h6" />
                </svg>
            </div>
            <span class="home-brand-name">LinguaAI</span>
        </div>

        <h1 class="home-title">Your AI language companion</h1>
        <p class="home-subtitle">
            Practice German, Korean, and English with real-time TTS,
            AI conversation, and instant translation.
        </p>

        
    </section>

    @* ── Feature cards ────────────────────────────────────────── *@
    <section class="home-features">

        <a class="home-feature-card" href="/tts">
            <div class="home-feature-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                     stroke="#5a7af9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" />
                    <path d="M19.07 4.93a10 10 0 0 1 0 14.14" />
                    <path d="M15.54 8.46a5 5 0 0 1 0 7.07" />
                </svg>
            </div>
            <p class="home-feature-title">Text to speech</p>
            <p class="home-feature-desc">Convert any text to natural-sounding audio in multiple languages.</p>
        </a>

        <a class="home-feature-card" href="/translate">
            <div class="home-feature-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                     stroke="#5a7af9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="17 1 21 5 17 9" />
                    <path d="M3 11V9a4 4 0 0 1 4-4h14" />
                    <polyline points="7 23 3 19 7 15" />
                    <path d="M21 13v2a4 4 0 0 1-4 4H3" />
                </svg>
            </div>
            <p class="home-feature-title">Translation</p>
            <p class="home-feature-desc">Instantly translate between German, Korean, and English with AI.</p>
        </a>

        @* 추가됨: Chat 카드에 New 뱃지, 전체 카드 링크 *@
        <a class="home-feature-card home-feature-card--accent" href="/chat">
            <span class="home-feature-new">New</span>
            <div class="home-feature-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                     stroke="#5a7af9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                </svg>
            </div>
            <p class="home-feature-title">AI chat</p>
            <p class="home-feature-desc">Practice conversations by topic and level, with auto voice playback.</p>
        </a>

    </section>

    @* ── How it works ─────────────────────────────────────────── *@
    <section class="home-steps-card">
        <p class="home-steps-label">How it works</p>
        <div class="home-steps">
            <div class="home-step">
                <div class="home-step-num">1</div>
                <p class="home-step-text">Pick a language &amp; topic</p>
            </div>
            <div class="home-step-line"></div>
            <div class="home-step">
                <div class="home-step-num">2</div>
                <p class="home-step-text">Chat with the AI tutor</p>
            </div>
            <div class="home-step-line"></div>
            <div class="home-step">
                <div class="home-step-num">3</div>
                <p class="home-step-text">Hear replies read aloud</p>
            </div>
        </div>
    </section>

    @* ── Footer ───────────────────────────────────────────────── *@
    <p class="home-footer">
        Powered by OpenAI TTS &amp; GPT-4o mini &nbsp;·&nbsp; Built with ASP.NET Core / Blazor
    </p>

</div>