@page "/chat"
@rendermode InteractiveServer
@implements IDisposable
@inject ChatService ChatSvc
@inject WhisperService WhisperSvc
@inject OpenAiTtsService TtsService
@inject IJSRuntime JS
 
<PageTitle>Chat — TTS Web App</PageTitle>
 
<div class="chat-card">
 
    @* ── 설정 화면 ──────────────────────────────────────────── *@
    @if (!isStarted)
    {
        <div class="chat-setup">
            <div class="chat-setup-header">
                <h2>AI Language Chat</h2>
                <p>Choose your language, topic, and level — then start practicing.</p>
            </div>
 
            <div class="chat-setup-section">
                <span class="chat-setup-label">Language</span>
                <div class="chat-option-bar">
                    @foreach (var lang in ChatService.Languages)
                    {
                        <button class="chat-option-btn @(selectedLang == lang.Code ? "active" : "")"
                                @onclick="() => selectedLang = lang.Code">
                            @lang.Label
                        </button>
                    }
                </div>
            </div>
 
            <div class="chat-setup-section">
                <span class="chat-setup-label">Topic</span>
                <div class="chat-option-bar">
                    @foreach (var cat in ChatService.Categories)
                    {
                        <button class="chat-option-btn @(selectedCategory == cat.Code ? "active" : "")"
                                @onclick="() => selectedCategory = cat.Code">
                            @cat.Label
                        </button>
                    }
                </div>
            </div>
 
            <div class="chat-setup-section">
                <span class="chat-setup-label">Level</span>
                <div class="chat-option-bar">
                    @foreach (var lv in ChatService.Levels)
                    {
                        <button class="chat-option-btn @(selectedLevel == lv.Code ? "active" : "")"
                                @onclick="() => selectedLevel = lv.Code">
                            @lv.Label
                        </button>
                    }
                </div>
            </div>
 
            <button class="chat-start-btn" @onclick="StartChat">
                Start Conversation →
            </button>
        </div>
    }
    else
    {
        @* ── 채팅 헤더 ──────────────────────────────────────── *@
        <div class="chat-header">
            <div class="chat-header-info">
                <h2>AI Language Chat</h2>
                <div class="chat-badges">
                    <span class="chat-badge">@ChatService.Languages.First(l => l.Code == selectedLang).Label</span>
                    <span class="chat-badge">@ChatService.Categories.First(c => c.Code == selectedCategory).Label</span>
                    <span class="chat-badge">@ChatService.Levels.First(l => l.Code == selectedLevel).Label</span>
                </div>
            </div>
            <button class="chat-reset-btn" @onclick="Reset">New chat</button>
        </div>
 
        @* ── 메시지 목록 ─────────────────────────────────────── *@
        <div class="chat-messages" id="chat-messages">
            @foreach (var msg in messages)
            {
                <div class="chat-bubble-wrap @(msg.Role == "user" ? "user" : "assistant")">
                    @if (msg.Role == "assistant")
                    {
                        <div class="chat-avatar">AI</div>
                    }
                    <div class="chat-bubble">
                        <p class="chat-bubble-text">@msg.Content</p>
                        @if (msg.Role == "assistant" && !isConversationMode)
                        {
                            @* 수동 모드에서만 개별 TTS 버튼 표시 *@
                            <div class="chat-bubble-actions">
                                @if (ttsLoadingIndex == messages.IndexOf(msg))
                                {
                                    <span class="chat-tts-spinner"></span>
                                }
                                else
                                {
                                    <button class="chat-tts-btn" @onclick="() => SpeakMessageManual(msg)" title="Listen">▶</button>
                                }
                                @if (audioUrls.TryGetValue(msg, out var url))
                                {
                                    <audio controls autoplay src="@url" class="chat-audio"></audio>
                                }
                            </div>
                        }
                    </div>
                    @if (msg.Role == "user")
                    {
                        <div class="chat-avatar user-avatar">Me</div>
                    }
                </div>
            }
 
            @if (isLoading)
            {
                <div class="chat-bubble-wrap assistant">
                    <div class="chat-avatar">AI</div>
                    <div class="chat-bubble chat-typing">
                        <span></span><span></span><span></span>
                    </div>
                </div>
            }
        </div>
 
        @if (errorMessage is not null)
        {
            <p class="chat-error">⚠ @errorMessage</p>
        }
 
        @* ── Voice Mode 인디케이터 (활성일 때만 표시) ─────────── *@
        @if (isConversationMode)
        {
            <div class="chat-conv-ui">
                @* 추가됨: 상태에 따라 색/애니메이션이 바뀌는 원형 인디케이터 *@
                <div class="chat-conv-indicator @convState">
                    @if (convState == "listening")
                    {
                        <svg width="28" height="28" viewBox="0 0 28 28" fill="currentColor">
                            <rect x="9" y="2" width="10" height="15" rx="5"/>
                            <path d="M5 14a9 9 0 0018 0" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/>
                            <line x1="14" y1="23" x2="14" y2="26" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                            <line x1="10" y1="26" x2="18" y2="26" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                        </svg>
                    }
                    else if (convState == "processing")
                    {
                        <span class="chat-conv-spinner"></span>
                    }
                    else if (convState == "speaking")
                    {
                        <svg width="28" height="28" viewBox="0 0 28 28" fill="currentColor">
                            <path d="M4 10h4l4-6 4 18 4-10 3 4h5" stroke="currentColor" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    }
                </div>
 
                @* 추가됨: 상태 텍스트 *@
                <p class="chat-conv-status-text">
                    @(convState switch {
                        "listening"  => "Listening…",
                        "processing" => "Thinking…",
                        "speaking"   => "Speaking…",
                        _            => "Starting…"
                    })
                </p>
 
                <button class="chat-conv-stop-btn" @onclick="StopConversationMode">
                    ■ Stop Voice Mode
                </button>
            </div>
        }
        else
        {
            @* ── 수동 입력 행 ──────────────────────────────────── *@
            <div class="chat-input-row">
                <button class="chat-mic-btn @(isRecording ? "recording" : "") @(isTranscribing ? "transcribing" : "")"
                        @onclick="ToggleRecording"
                        disabled="@(isLoading || isTranscribing)"
                        title="@(isRecording ? "Stop recording" : "Record once")">
                    @if (isTranscribing)
                    {
                        <span class="chat-mic-spinner"></span>
                    }
                    else if (isRecording)
                    {
                        <svg width="18" height="18" viewBox="0 0 18 18" fill="currentColor">
                            <rect x="3" y="3" width="12" height="12" rx="2"/>
                        </svg>
                    }
                    else
                    {
                        <svg width="18" height="18" viewBox="0 0 18 18" fill="currentColor">
                            <rect x="6" y="1" width="6" height="9" rx="3"/>
                            <path d="M3 9a6 6 0 0012 0" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round"/>
                            <line x1="9" y1="15" x2="9" y2="17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                            <line x1="6" y1="17" x2="12" y2="17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                        </svg>
                    }
                </button>
 
                <textarea class="chat-input"
                          @bind="userInput"
                          @bind:event="oninput"
                          @onkeydown="OnKeyDown"
                          rows="2"
                          placeholder="@(isRecording ? "Recording… click ■ to stop" : "Type here or use mic… (Enter to send)")"
                          disabled="@(isLoading || isRecording)"></textarea>
 
                <button class="chat-send-btn" @onclick="SendMessage"
                        disabled="@(isLoading || isRecording || isTranscribing || string.IsNullOrWhiteSpace(userInput))">
                    @if (isLoading)
                    {
                        <span class="chat-send-spinner"></span>
                    }
                    else
                    {
                        <span>Send</span>
                    }
                </button>
            </div>
 
            @* 추가됨: Voice Mode 시작 버튼 *@
            <button class="chat-voice-mode-btn" @onclick="StartConversationMode"
                    disabled="@isLoading">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                    <rect x="5" y="1" width="6" height="8" rx="3"/>
                    <path d="M2 8a6 6 0 0012 0" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round"/>
                    <line x1="8" y1="14" x2="8" y2="16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
                Start Voice Mode
            </button>
        }
    }
 
</div>

@code {
    private string selectedLang     = "de";
    private string selectedCategory = "daily";
    private string selectedLevel    = "beginner";

    private bool isStarted;
    private bool isLoading;
    private bool isRecording;
    private bool isTranscribing;
    private int  ttsLoadingIndex = -1;
    private string? errorMessage;
    private string userInput = "";

    // 추가됨: Voice Mode 상태
    private bool   isConversationMode = false;
    private string convState          = "idle"; // idle | listening | processing | speaking

    private List<ChatMessage>            messages  = new();
    private Dictionary<ChatMessage, string> audioUrls = new();

    private DotNetObjectReference<Chat>? _dotNetRef;

    protected override void OnInitialized()
    {
        _dotNetRef = DotNetObjectReference.Create(this);
    }

    private async Task StartChat()
    {
        isStarted = true;
        await GetAiReply(autoSpeak: false); // 첫 인사는 자동 재생 안 함
    }

    private async Task Reset()
    {
        await StopConversationMode();
        if (isRecording)
        {
            isRecording = false;
            await JS.InvokeVoidAsync("stopRecording", _dotNetRef);
        }
        isStarted  = false;
        messages.Clear();
        audioUrls.Clear();
        userInput     = "";
        errorMessage  = null;
        convState     = "idle";
    }

    // ── 수동 텍스트 전송 ──────────────────────────────────────────
    private async Task SendMessage()
    {
        var text = userInput.Trim();
        if (string.IsNullOrWhiteSpace(text)) return;
        messages.Add(new ChatMessage("user", text));
        userInput = "";
        await GetAiReply(autoSpeak: false);
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey) await SendMessage();
    }

    // ── 수동 마이크 (단발성) ──────────────────────────────────────
    private async Task ToggleRecording()
    {
        if (!isRecording)
        {
            errorMessage = null;
            var ok = await JS.InvokeAsync<bool>("startRecording");
            if (!ok) { errorMessage = "Microphone access denied."; return; }
            isRecording = true;
        }
        else
        {
            isRecording    = false;
            isTranscribing = true;
            await JS.InvokeVoidAsync("stopRecording", _dotNetRef);
        }
    }

    // 추가됨: JS → 오디오 base64 전달 (수동 모드 & Voice Mode 공용)
    [JSInvokable]
    public async Task OnAudioRecorded(string base64Audio)
    {
        try
        {
            var bytes      = Convert.FromBase64String(base64Audio);
            var transcript = await WhisperSvc.TranscribeAsync(bytes, selectedLang);

            if (isConversationMode)
            {
                // 추가됨: Voice Mode — 전사 즉시 자동 전송
                if (!string.IsNullOrWhiteSpace(transcript))
                {
                    messages.Add(new ChatMessage("user", transcript));
                    await InvokeAsync(StateHasChanged);
                    await GetAiReply(autoSpeak: true);
                }
                else
                {
                    // 추가됨: 말이 없었으면 다시 듣기 시작
                    await ResumeListening();
                }
            }
            else
            {
                // 수동 모드 — 입력창에만 채워줌
                userInput      = transcript;
                isTranscribing = false;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            errorMessage   = $"Transcription failed: {ex.Message}";
            isTranscribing = false;
            if (isConversationMode) convState = "listening";
            await InvokeAsync(StateHasChanged);
        }
    }

    // 추가됨: TTS 재생이 끝나면 JS가 이 메서드를 호출 → 마이크 자동 재오픈
    [JSInvokable]
    public async Task OnTtsEnded()
    {
        if (!isConversationMode) return;
        await ResumeListening();
    }

    // 추가됨: Voice Mode 오류 수신
    [JSInvokable]
    public async Task OnConvError(string message)
    {
        errorMessage = message;
        isConversationMode = false;
        convState = "idle";
        await InvokeAsync(StateHasChanged);
    }

    // ── Voice Mode 제어 ───────────────────────────────────────────
    private async Task StartConversationMode()
    {
        isConversationMode = true;
        convState          = "listening";
        errorMessage       = null;
        await InvokeAsync(StateHasChanged);
        await JS.InvokeVoidAsync("startConversationListening", _dotNetRef, 1500);
    }

    private async Task StopConversationMode()
    {
        isConversationMode = false;
        convState          = "idle";
        await JS.InvokeVoidAsync("stopConversationMode");
        await InvokeAsync(StateHasChanged);
    }

    // 추가됨: TTS 종료 후 다시 듣기 재개
    private async Task ResumeListening()
    {
        if (!isConversationMode) return;
        convState = "listening";
        await InvokeAsync(StateHasChanged);
        await JS.InvokeVoidAsync("startConversationListening", _dotNetRef, 1500);
    }

    // ── AI 응답 요청 ──────────────────────────────────────────────
    private async Task GetAiReply(bool autoSpeak)
    {
        errorMessage = null;
        isLoading    = true;
        if (isConversationMode) convState = "processing";
        await InvokeAsync(StateHasChanged);
        await JS.InvokeVoidAsync("scrollToBottom", "chat-messages");

        try
        {
            var reply = await ChatSvc.SendMessageAsync(
                messages, selectedLang, selectedCategory, selectedLevel);
            messages.Add(new ChatMessage("assistant", reply));

            if (autoSpeak && isConversationMode)
            {
                // 추가됨: Voice Mode — TTS 자동 재생 + 끝나면 OnTtsEnded 콜백
                convState = "speaking";
                await InvokeAsync(StateHasChanged);
                var model = selectedLang is "ko" or "de" ? "tts-1-hd" : "tts-1";
                var bytes = await TtsService.SynthesizeSpeechAsync(reply, model: model);
                var b64   = Convert.ToBase64String(bytes);
                await JS.InvokeVoidAsync("playAudioAndNotify", b64, _dotNetRef);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
            if (isConversationMode) await ResumeListening();
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
            await JS.InvokeVoidAsync("scrollToBottom", "chat-messages");
        }
    }

    // ── 수동 모드 개별 TTS 버튼 ──────────────────────────────────
    private async Task SpeakMessageManual(ChatMessage msg)
    {
        ttsLoadingIndex = messages.IndexOf(msg);
        errorMessage    = null;
        try
        {
            var model = selectedLang is "ko" or "de" ? "tts-1-hd" : "tts-1";
            var bytes = await TtsService.SynthesizeSpeechAsync(msg.Content, model: model);
            audioUrls[msg] = $"data:audio/mpeg;base64,{Convert.ToBase64String(bytes)}";
        }
        catch (Exception ex) { errorMessage = $"TTS error: {ex.Message}"; }
        finally { ttsLoadingIndex = -1; }
    }

    public void Dispose()
    {
        _dotNetRef?.Dispose();
    }
}