@page "/chat"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject ChatService ChatSvc
@inject OpenAiTtsService TtsService
@inject IJSRuntime JS

<PageTitle>Chat — TTS Web App</PageTitle>

<div class="chat-card">

    @* ── Setup screen ────────────────────────────────────────── *@
    @if (!isStarted)
    {
        <div class="chat-setup">
            <div class="chat-setup-header">
                <h2>AI Language Chat</h2>
                <p>Choose your language, topic, and level — then start practicing.</p>
            </div>

            <div class="chat-setup-section">
                <span class="chat-setup-label">Language</span>
                <div class="chat-option-bar">
                    @foreach (var lang in ChatService.Languages)
                    {
                        <button class="chat-option-btn @(selectedLang == lang.Code ? "active" : "")"
                                @onclick="() => selectedLang = lang.Code">
                            @lang.Label
                        </button>
                    }
                </div>
            </div>

            <div class="chat-setup-section">
                <span class="chat-setup-label">Topic</span>
                <div class="chat-option-bar">
                    @foreach (var cat in ChatService.Categories)
                    {
                        <button class="chat-option-btn @(selectedCategory == cat.Code ? "active" : "")"
                                @onclick="() => selectedCategory = cat.Code">
                            @cat.Label
                        </button>
                    }
                </div>
            </div>

            <div class="chat-setup-section">
                <span class="chat-setup-label">Level</span>
                <div class="chat-option-bar">
                    @foreach (var lv in ChatService.Levels)
                    {
                        <button class="chat-option-btn @(selectedLevel == lv.Code ? "active" : "")"
                                @onclick="() => selectedLevel = lv.Code">
                            @lv.Label
                        </button>
                    }
                </div>
            </div>

            <button class="chat-start-btn" @onclick="StartChat">
                Start Conversation →
            </button>
        </div>
    }
    else
    {
        @* ── Chat header ────────────────────────────────────── *@
        <div class="chat-header">
            <div class="chat-header-info">
                <h2>AI Language Chat</h2>
                <div class="chat-badges">
                    <span class="chat-badge">@ChatService.Languages.First(l => l.Code == selectedLang).Label</span>
                    <span class="chat-badge">@ChatService.Categories.First(c => c.Code == selectedCategory).Label</span>
                    <span class="chat-badge">@ChatService.Levels.First(l => l.Code == selectedLevel).Label</span>
                </div>
            </div>
            <button class="chat-reset-btn" @onclick="Reset">New chat</button>
        </div>

        @* ── Message list ──────────────────────────────────── *@
        <div class="chat-messages" id="chat-messages">
            @foreach (var msg in messages)
            {
                var idx = messages.IndexOf(msg);
                <div class="chat-bubble-wrap @(msg.Role == "user" ? "user" : "assistant")">
                    @if (msg.Role == "assistant")
                    {
                        <div class="chat-avatar">AI</div>
                    }
                    <div class="chat-bubble">
                        <p class="chat-bubble-text">@msg.Content</p>

                        @* Added: TTS playback button on all messages *@
                        <div class="chat-bubble-actions">
                            @if (ttsLoadingIndex == idx)
                            {
                                <span class="chat-tts-spinner"></span>
                            }
                            else
                            {
                                <button class="chat-tts-btn" @onclick="() => SpeakMessage(idx)" title="Play">▶</button>
                            }
                            @if (audioUrls.ContainsKey(idx))
                            {
                                <audio controls src="@audioUrls[idx]" class="chat-audio"></audio>
                            }
                        </div>
                    </div>
                    @if (msg.Role == "user")
                    {
                        <div class="chat-avatar user-avatar">Me</div>
                    }
                </div>
            }

            @if (isLoading)
            {
                <div class="chat-bubble-wrap assistant">
                    <div class="chat-avatar">AI</div>
                    <div class="chat-bubble chat-typing">
                        <span></span><span></span><span></span>
                    </div>
                </div>
            }
        </div>

        @if (errorMessage is not null)
        {
            <p class="chat-error">⚠ @errorMessage</p>
        }

        @* ── Input row ──────────────────────────────────────── *@
        <div class="chat-input-row">
            <textarea class="chat-input"
                      @bind="userInput"
                      @bind:event="oninput"
                      @onkeydown="OnKeyDown"
                      rows="2"
                      placeholder="Type your message… (Enter to send, Shift+Enter for new line)"
                      disabled="@isLoading"></textarea>

            <button class="chat-send-btn" @onclick="SendMessage"
                    disabled="@(isLoading || string.IsNullOrWhiteSpace(userInput))">
                @if (isLoading) { <span class="chat-send-spinner"></span> }
                else { <span>Send</span> }
            </button>
        </div>
    }

</div>

@code {
    private string selectedLang     = "de";
    private string selectedCategory = "daily";
    private string selectedLevel    = "beginner";

    private bool    isStarted;
    private bool    isLoading;
    private int     ttsLoadingIndex = -1;
    private string? errorMessage;
    private string  userInput = "";

    private List<ChatMessage>          messages  = new();
    // Added: store audio URLs keyed by index (for both user/AI)
    private Dictionary<int, string>    audioUrls = new();

    private async Task StartChat()
    {
        isStarted = true;
        await GetAiReply();
    }

    private async Task Reset()
    {
        isStarted = false;
        messages.Clear();
        audioUrls.Clear();
        userInput    = "";
        errorMessage = null;
    }

    private async Task SendMessage()
    {
        var text = userInput.Trim();
        if (string.IsNullOrWhiteSpace(text)) return;

        messages.Add(new ChatMessage("user", text));
        userInput = "";
        await GetAiReply();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey) await SendMessage();
    }

    private async Task GetAiReply()
    {
        errorMessage = null;
        isLoading    = true;
        StateHasChanged();
        await JS.InvokeVoidAsync("scrollToBottom", "chat-messages");

        try
        {
            var reply = await ChatSvc.SendMessageAsync(
                messages, selectedLang, selectedCategory, selectedLevel);

            messages.Add(new ChatMessage("assistant", reply));
            isLoading = false;
            StateHasChanged();
            await JS.InvokeVoidAsync("scrollToBottom", "chat-messages");

            // Added: automatically play TTS for the AI reply
            await AutoPlayTts(messages.Count - 1, reply);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            isLoading    = false;
            StateHasChanged();
        }
    }

    // Added: auto-play after TTS generation + store audio URL (allows replay via the ▶ button)
    private async Task AutoPlayTts(int index, string text)
    {
        try
        {
            var model = selectedLang is "ko" or "de" ? "tts-1-hd" : "tts-1";
            var bytes = await TtsService.SynthesizeSpeechAsync(text, model: model);
            var b64   = Convert.ToBase64String(bytes);

            audioUrls[index] = $"data:audio/mpeg;base64,{b64}";
            StateHasChanged();

            // Added: auto-play via JS (workaround for the browser's autoplay policy)
            await JS.InvokeVoidAsync("playAudio", b64);
        }
        catch { /* keep the chat going even if TTS fails */ }
    }

    // Added: play TTS for the corresponding message when the ▶ button is clicked
    private async Task SpeakMessage(int index)
    {
        if (ttsLoadingIndex >= 0) return; // ignore if already loading

        // play immediately if audio has already been generated
        if (audioUrls.TryGetValue(index, out var existing))
        {
            var b64 = existing.Replace("data:audio/mpeg;base64,", "");
            await JS.InvokeVoidAsync("playAudio", b64);
            return;
        }

        ttsLoadingIndex = index;
        errorMessage    = null;
        StateHasChanged();

        try
        {
            var model = selectedLang is "ko" or "de" ? "tts-1-hd" : "tts-1";
            var bytes = await TtsService.SynthesizeSpeechAsync(messages[index].Content, model: model);
            var b64   = Convert.ToBase64String(bytes);

            audioUrls[index] = $"data:audio/mpeg;base64,{b64}";
            StateHasChanged();
            await JS.InvokeVoidAsync("playAudio", b64);
        }
        catch (Exception ex) { errorMessage = $"TTS error: {ex.Message}"; }
        finally { ttsLoadingIndex = -1; StateHasChanged(); }
    }
}