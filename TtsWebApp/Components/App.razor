<!-- MODIFIED: lang attribute changed from "ko" to "en" to match the English-language UI -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TTS Web App</title>
    <base href="/" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="TtsWebApp.styles.css" />
    <HeadOutlet />
</head>
<body>
<Routes />
<script src="_framework/blazor.web.js"></script>
<script>
        // Added: automatically scroll chat messages to the bottom
        function scrollToBottom(id) {
            const el = document.getElementById(id);
            if (el) el.scrollTop = el.scrollHeight;
        }

        // Added: play base64 audio (workaround for autoplay policy)
        function playAudio(base64) {
            const audio = new Audio('data:audio/mpeg;base64,' + base64);
            audio.play().catch(() => {}); // ignore even if autoplay is blocked
        }
    </script>
</body>
</html>