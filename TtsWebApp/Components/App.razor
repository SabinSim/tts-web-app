<!-- MODIFIED: lang attribute changed from "ko" to "en" to match the English-language UI -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TTS Web App</title>
    <base href="/" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="TtsWebApp.styles.css" />
    <HeadOutlet />
</head>
<body>
<Routes />
<script src="_framework/blazor.web.js"></script>
<script>
        // 추가됨: 채팅 메시지 자동 스크롤
        function scrollToBottom(id) {
            const el = document.getElementById(id);
            if (el) el.scrollTop = el.scrollHeight;
        }

        // 추가됨: base64 오디오 재생 (autoplay 정책 우회)
        function playAudio(base64) {
            const audio = new Audio('data:audio/mpeg;base64,' + base64);
            audio.play().catch(() => {}); // 자동재생 차단돼도 무시
        }
    </script>
</body>
</html>